# ─── Base de datos ──────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/noutlife"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/noutlife"

# ─── JWT ────────────────────────────────────────────────────
JWT_SECRET="cambia-esto-por-un-secreto-de-minimo-32-caracteres"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="otro-secreto-diferente-minimo-32-caracteres"
REFRESH_TOKEN_EXPIRES_IN="7d"

# ─── Servidor ───────────────────────────────────────────────
PORT=3001
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"

# ─── Web Push (generar con: npx web-push generate-vapid-keys) ──
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@noutlife.app"

# ─── IA ─────────────────────────────────────────────────────
# El servidor prueba los proveedores en este orden: Groq → Gemini → OpenRouter → OpenAI.
# Groq tiene el nivel gratuito más generoso: https://console.groq.com/keys
# (el default llama-3.1-8b-instant da ~14.400 req/día; el 70B da solo ~1.000/día)
GROQ_API_KEY=""
# Varias llaves y modelos separados por comas multiplican el cupo gratuito (cada uno tiene el suyo):
# GROQ_API_KEY="llave1,llave2"
# GROQ_MODEL="llama-3.1-8b-instant,llama-3.3-70b-versatile"
# Solo el chat del Sabio tiene tope; el resto de la IA (comida, inicio...) no lo usa.
# Presupuesto diario del chat para todos (default 3000). Se reparte entre la gente activa
# hoy: el tope por persona va de SAGE_MIN_DAILY_LIMIT (5) a SAGE_DAILY_AI_LIMIT (60).
# SAGE_DAILY_CHAT_BUDGET=3000
# SAGE_DAILY_AI_LIMIT=60
# SAGE_MIN_DAILY_LIMIT=5
# Gemini (aistudio.google.com/app/apikey, ≈1.500 req/día en nivel gratuito).
# ⚠ NUNCA pegues tu llave real en este archivo: .env.example va al repositorio.
# Si una llave llegó a un repo/commit, rótala en Google AI Studio de inmediato.
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""

# ─── Integraciones OAuth ──────────────────────────────────
# Spotify — Configurar en https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REDIRECT_URI="http://localhost:3001/api/v1/integrations/spotify/callback"

# Google Calendar — Configurar en Google Cloud Console
# Sign-in (only Google). GOOGLE_CLIENT_ID is the Web OAuth client id;
# the same id serves Google Calendar. Authorized JavaScript origins
# must include the web URL.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/v1/integrations/google/callback"
# URL de retorno al conectar Google Calendar. Debe estar tal cual en Google Cloud Console →
# Credenciales → cliente web → «URIs de redireccionamiento autorizados» (si no: redirect_uri_mismatch).
# Vacía = la página /agenda desde la que se conecta (p. ej. https://noutlife.vercel.app/agenda).
GOOGLE_CALENDAR_REDIRECT_URI=""

# Google Fit — Mismo proyecto que Google Calendar
GOOGLE_FIT_CLIENT_ID=""

# ─── URLs ────────────────────────────────────────────────
API_URL="http://localhost:3001"
WEB_URL="http://localhost:5173"

# ─── Recordatorios (serverless) ─────────────────────────────
# Protege /api/v1/cron/tick. Ver .github/workflows/reminders.yml
# El mismo tick cobra las suscripciones vencidas o las pasa a NoutLife Lite.
CRON_SECRET=""

# ─── Pagos: NoutLife Pro con Wompi ──────────────────────────
# Dashboard de Wompi → Desarrolladores. Las llaves *_test_* usan el Sandbox
# (https://sandbox.wompi.co/v1); las *_prod_*, producción.
# La prueba de 7 días requiere obligatoriamente registrar un método de pago válido (Tarjeta o Nequi) vía Wompi desde el primer día.
# Paywall de entrada: con estas llaves nadie entra al Dashboard sin vincular antes un método de pago
# ($0 hoy con la prueba; si el correo o el medio de pago ya la usaron, cobro directo o NoutLife Lite).
# Sin estas llaves no hay paywall, prueba ni cobros: la app funciona en NoutLife Lite.
# La pública va al navegador (tokeniza la tarjeta y vincula Nequi); las demás, nunca.
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
# "Secretos para integración técnica": integridad (firma de cada cobro) y eventos (webhook).
WOMPI_INTEGRITY_SECRET=""
WOMPI_EVENTS_SECRET=""
# URL de eventos a configurar en Wompi (una por ambiente):
#   <API>/api/v1/billing/webhook
# WOMPI_API_URL=""   # opcional: fuerza la URL base de la API de Wompi

# ─── Huella anti-abuso de la prueba con Nequi ───────────────
# Combina el celular y la cédula de cada prueba con Nequi. Sin ella no se acepta Nequi.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# No la cambies después de usarla: las huellas guardadas dejan de coincidir y una persona podría repetir la prueba.
TRIAL_FINGERPRINT_SECRET=""

# ─── Pro de cortesía ────────────────────────────────────────
# Correos separados por comas con NoutLife Pro sin fecha de vencimiento: sin paywall y sin cobros.
# No se guardan en la base: para quitar uno, bórralo de la lista y redespliega la API.
COMP_PRO_EMAILS=""
