generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum QuestType {
  MAIN
  SIDE
  DAILY
  WEEKLY
  META
}

enum QuestStatus {
  ACTIVE
  COMPLETED
  FAILED
  ARCHIVED
}

enum QuestDifficulty {
  EASY
  NORMAL
  HARD
  EPIC
}

enum QuestCategory {
  HEALTH
  FITNESS
  FINANCE
  LEARNING
  LOVE
  SOCIAL
  PERSONAL
  CREATIVE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  FOOD
  TRANSPORT
  ENTERTAINMENT
  SAVINGS
  INVESTMENT
  HEALTH
  EDUCATION
  CLOTHING
  UTILITIES
  HOUSING
  SUBSCRIPTIONS
  OTHER
}

enum RelationshipStatus {
  SINGLE
  IN_RELATIONSHIP
  COMPLICATED
  PREFER_NOT_TO_SAY
}

enum GymAttendanceSource {
  HABIT
  MANUAL
}

enum NotificationCategory {
  HABITS
  QUESTS
  GYM
  FINANCE
  SOCIAL
  ACHIEVEMENTS
  SYSTEM
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id           String @id @default(cuid())
  email        String @unique
  username     String @unique
  /// Legacy: sign-in is Google only. Kept nullable for old accounts.
  passwordHash String?
  googleSub    String? @unique
  displayName  String @default("Héroe")

  level         Int @default(1)
  xp            Int @default(0)
  xpToNextLevel Int @default(100)
  gold          Int @default(0)

  hp           Int @default(100)
  maxHp        Int @default(100)
  strength     Int @default(1)
  intelligence Int @default(1)
  charisma     Int @default(1)

  avatarConfig Json @default("{\"hairColor\":\"#4a3728\",\"skinColor\":\"#c68642\",\"shirtColor\":\"#4d96ff\",\"pants\":\"#37474f\",\"accessory\":null,\"pet\":null}")
  avatarUrl    String?

  timezone           String             @default("America/Bogota")
  currency           String             @default("COP")
  language           String             @default("es")
  relationshipStatus RelationshipStatus @default(SINGLE)

  onboardingCompleted Boolean   @default(false)
  onboardingCompletedAt DateTime?
  birthDate           DateTime?
  currentStreak       Int       @default(0)
  longestStreak       Int       @default(0)
  lastActivityDate    DateTime?
  sevenDayGuideCompletedDays Json      @default("[]")
  sevenDayGuideCompletedAt   DateTime?
  sevenDayGuideDismissedAt   DateTime?

  inviteCode         String?  @unique
  sageCallsToday     Int      @default(0)
  sageCallsResetAt   DateTime @default(now())

  gymPlaylistUrl     String?

  playerClass    String?
  classChosenAt  DateTime?
  activeTheme    String   @default("aurora")
  bedtimeGoal    String?

  equippedHat    String?
  equippedAura   String?
  equippedFrame  String?
  equippedTheme  String?
  morningBriefingLastSeen DateTime?

  // Fase 9 — Glow Up
  lifeScore           Int @default(0)
  focusMinutesTotal   Int @default(0)

  refreshTokenHash String?
  lastLoginAt      DateTime?
  /// Última petición autenticada (como mucho una escritura por hora). Mide la gente activa hoy para repartir el cupo del Sabio.
  lastSeenAt       DateTime?

  // Red social: biografía, privacidad y presencia (en línea y zona actual).
  bio          String?
  /// { friendsList: 'public'|'friends'|'private', profile: 'public'|'friends', showOnline, showZone, readReceipts }
  privacy      Json      @default("{}")
  /// Color del nombre en cartas y gremios (clave de la paleta: "jade", "coral"…).
  nameColor    String?
  presenceAt   DateTime?
  presenceZone String?

  /// Racha general perdida hace poco: se puede revivir con oro durante 72 h.
  lostStreak   Int       @default(0)
  lostStreakAt DateTime?

  // Google Calendar Integration
  googleAccessToken         String?
  googleRefreshToken        String?
  googleTokenExpiresAt      DateTime?
  googleCalendarId          String?   @default("primary")
  googleCalendarSyncEnabled  Boolean   @default(false)
  googleCalendarLastSyncAt  DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  quests                  Quest[]
  questCompletions        QuestCompletion[]
  habits                  Habit[]
  habitLogs               HabitLog[]
  transactions            Transaction[]
  budgets                 Budget[]
  financialGoals          FinancialGoal[]
  workouts                Workout[]
  meals                   Meal[]
  sleepLogs               SleepLog[]
  journalEntries          JournalEntry[]
  inventoryItems          InventoryItem[]
  achievements            UserAchievement[]
  relationships           Relationship[]
  routines                Routine[]
  gymAttendances          GymAttendance[]
  learningItems           LearningItem[]
  xpEvents                XpEvent[]
  pushSubscriptions       PushSubscription[]
  notificationPreferences NotificationPreferences?
  notificationCategoryPreferences NotificationCategoryPreference[]
  sentFriendRequests      Friendship[]             @relation("SentRequests")
  receivedFriendRequests  Friendship[]             @relation("ReceivedRequests")
  createdChallenges       Challenge[]
  challengeParticipants   ChallengeParticipant[]
  guildMemberships        GuildMember[]
  guildInvitesSent        GuildInvite[]            @relation("GuildInviter")
  guildInvitesReceived    GuildInvite[]            @relation("GuildInvitee")
  sentMessages            DirectMessage[]          @relation("DMSender")
  receivedMessages        DirectMessage[]          @relation("DMReceiver")
  gesturesSent            SocialGesture[]          @relation("GestureFrom")
  gesturesReceived        SocialGesture[]          @relation("GestureTo")
  messageReactions        MessageReaction[]
  chatViews               ChatView[]
  chatPrefs               ChatPref[]
  blocksMade              UserBlock[]              @relation("BlocksMade")
  blocksReceived          UserBlock[]              @relation("BlocksReceived")
  stickers                Sticker[]
  guildMessages           GuildMessage[]
  sageMemories            SageMemory[]
  sageInsights            SageInsight[]
  sageProactiveNotes      SageProactiveNote[]
  weeklySummaries         WeeklySummary[]
  recoveryChallenges      RecoveryChallenge[]
  seasonParticipants      SeasonParticipant[]
  agendaEvents            AgendaEvent[]
  bodyWeights             BodyWeight[]
  progressPhotos          ProgressPhoto[]
  debts                   Debt[]
  recurringTransactions   RecurringTransaction[]
  nutritionGoal           NutritionGoal?
  savedMeals              SavedMeal[]
  giftIdeas               GiftIdea[]
  masterGoals             MasterGoal[]
  rituals                 Ritual[]
  ritualLogs              RitualLog[]
  dailyCheckins           DailyCheckin[]
  sageScrolls             SageScroll[]
  focusSessions           FocusSession[]
  inAppNotifications      Notification[]
  customZones             CustomZone[]
  careRoutines            CareRoutine[]
  careLogs                CareLog[]
  clothingItems           ClothingItem[]
  outfits                 Outfit[]
  styleWishlists          StyleWishlist[]
  presenceCheckins        PresenceCheckin[]
  feedbackEntries         Feedback[]

  @@map("users")
}

model Quest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  customZoneId String?
  customZone   CustomZone? @relation(fields: [customZoneId], references: [id])

  title       String
  description String?
  type        QuestType
  status      QuestStatus     @default(ACTIVE)
  difficulty  QuestDifficulty @default(NORMAL)
  category    QuestCategory

  xpReward   Int @default(50)
  goldReward Int @default(10)

  deadline    DateTime?
  completedAt DateTime?

  isRecurring Boolean   @default(false)
  resetCron   String?
  lastResetAt DateTime?

  subObjectives Json @default("[]")

  parentQuestId String?
  parentQuest   Quest?  @relation("SubQuests", fields: [parentQuestId], references: [id])
  subQuests     Quest[] @relation("SubQuests")

  completions QuestCompletion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quests")
}

model QuestCompletion {
  id      String @id @default(cuid())
  questId String
  quest   Quest  @relation(fields: [questId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  xpEarned    Int
  goldEarned  Int
  completedAt DateTime @default(now())
  notes       String?

  @@map("quest_completions")
}

model Habit {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  customZoneId String?
  customZone   CustomZone? @relation(fields: [customZoneId], references: [id])

  title       String
  description String?
  category    QuestCategory

  icon  String @default("⭐")
  color String @default("#ffd23f")

  xpReward   Int @default(20)
  goldReward Int @default(5)

  currentStreak Int @default(0)
  longestStreak Int @default(0)
  /// Racha perdida hace poco (revivible con oro durante 72 h).
  lostStreak    Int       @default(0)
  lostStreakAt  DateTime?

  frequency    Json    @default("{\"type\":\"daily\",\"days\":[]}")
  resetTime    String  @default("04:00")
  reminderTime String?
  isActive     Boolean @default(true)
  // Completing this habit creates attendance in the Gym for the same local day.
  createsGymAttendance Boolean @default(false)

  // If enabled, Noutlife owns a recurring event in the linked Google Calendar.
  // The instances are imported back into Agenda using their Google IDs.
  syncToGoogleCalendar  Boolean @default(false)
  googleCalendarEventId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs HabitLog[]
  recoveryChallenges RecoveryChallenge[]
  gymAttendances GymAttendance[] @relation("GymAttendanceHabit")

  @@map("habits")
}

model HabitLog {
  id      String @id @default(cuid())
  habitId String
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  completed Boolean
  status    String   @default("completed") // "completed" | "failed" | "skipped"
  date      DateTime
  notes     String?
  loggedAt  DateTime @default(now())

  @@unique([habitId, date])
  @@map("habit_logs")
}

model Transaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        TransactionType
  amount      Decimal             @db.Decimal(15, 2)
  currency    String              @default("COP")
  category    TransactionCategory
  description String?
  date        DateTime

  budgetId String?
  budget   Budget? @relation(fields: [budgetId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("transactions")
}

model Budget {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  category     TransactionCategory
  amount       Decimal             @db.Decimal(15, 2)
  month        Int
  year         Int
  currency     String              @default("COP")

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, category, month, year])
  @@map("budgets")
}

model FinancialGoal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String
  description   String?
  targetAmount  Decimal   @db.Decimal(15, 2)
  currentAmount Decimal   @default(0) @db.Decimal(15, 2)
  currency      String    @default("COP")

  deadline    DateTime?
  isCompleted Boolean   @default(false)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("financial_goals")
}

model Workout {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title      String
  notes      String?
  duration   Int?
  date       DateTime
  xpEarned   Int      @default(0)
  goldEarned Int      @default(0)

  routineDayId String?
  routineDay   RoutineDay? @relation(fields: [routineDayId], references: [id], onDelete: SetNull)
  attendanceId String?
  attendance   GymAttendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)

  exercises WorkoutExercise[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("workouts")
}

model Exercise {
  id          String  @id @default(cuid())
  name        String  @unique
  muscleGroup String?
  equipment   String?

  workoutExercises WorkoutExercise[]
  routineDayExercises RoutineDayExercise[]

  @@map("exercises")
}

model WorkoutExercise {
  id         String   @id @default(cuid())
  workoutId  String
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])

  sets  Json   @default("[]")
  notes String?
  order Int    @default(0)

  @@map("workout_exercises")
}

model Meal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  mealType String
  calories Int?
  protein  Float?
  carbs    Float?
  fat      Float?
  waterMl  Int?
  date     DateTime

  createdAt DateTime @default(now())

  @@map("meals")
}

model SleepLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bedtime          DateTime
  wakeTime         DateTime
  duration         Float
  quality          Int
  notes            String?
  date             DateTime
  sleepScore       Int?
  caffeineLate     Boolean?
  screensBeforeBed Boolean?
  exercisedToday   Boolean?
  // Siesta: suma al descanso del día pero no cuenta como noche (medias, puntuación, tendencia).
  isNap            Boolean  @default(false)

  createdAt DateTime @default(now())

  @@map("sleep_logs")
}

model JournalEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String?
  content String
  mood    Int?
  date    DateTime
  tags    String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("journal_entries")
}

model Routine {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name              String
  description       String?
  exercises         Json @default("[]")
  targetDays        Json @default("[]")
  estimatedDuration Int?
  isActive          Boolean @default(true)

  // `exercises` and `targetDays` are retained for existing routines. New and
  // edited weekly plans use the normalized days/exercises below.
  days RoutineDay[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("routines")
}

model RoutineDay {
  id        String  @id @default(cuid())
  routineId String
  routine   Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  weekday   Int
  title     String?
  isRestDay Boolean @default(false)
  exercises RoutineDayExercise[]
  workouts  Workout[]

  @@unique([routineId, weekday])
  @@index([routineId, weekday])
  @@map("routine_days")
}

model RoutineDayExercise {
  id           String     @id @default(cuid())
  routineDayId String
  routineDay   RoutineDay @relation(fields: [routineDayId], references: [id], onDelete: Cascade)
  exerciseId   String
  exercise     Exercise   @relation(fields: [exerciseId], references: [id])

  targetSets Json @default("[]")
  notes      String?
  order      Int  @default(0)

  @@index([routineDayId, order])
  @@map("routine_day_exercises")
}

model GymAttendance {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Calendar-date key in the user's timezone, normalized to UTC midnight.
  date   DateTime
  source GymAttendanceSource @default(MANUAL)
  habitId String?
  habit   Habit? @relation("GymAttendanceHabit", fields: [habitId], references: [id], onDelete: SetNull)
  workouts Workout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@map("gym_attendances")
}

model LearningItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type            String
  title           String
  author          String?
  platform        String?
  status          String   @default("NOT_STARTED")
  currentProgress Int      @default(0)
  totalProgress   Int      @default(0)
  rating          Int?
  notes           String?
  richNotes       Json     @default("[]")
  vocabularyCards Json     @default("[]")
  startedAt       DateTime?
  completedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("learning_items")
}

model ShopItem {
  id          String  @id @default(cuid())
  name        String
  description String?
  type        String
  cost        Int
  imageKey    String?

  levelRequired Int     @default(1)
  isLimited     Boolean @default(false)

  /// Parte del personaje que cambia: "extra" (accesorio pixel), "hair", "top", "aura", "frame", "theme"…
  slot          String?
  /// Valor que se aplica en esa parte (id del accesorio, peinado o prenda; clave del aura o marco).
  value         String?
  /// Exclusivo: unidades limitadas para toda la comunidad (null = sin límite).
  stock         Int?
  sold          Int     @default(0)

  inventoryItems InventoryItem[]

  createdAt DateTime @default(now())

  @@map("shop_items")
}

model InventoryItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopItemId String
  shopItem   ShopItem @relation(fields: [shopItemId], references: [id])

  isEquipped  Boolean   @default(false)
  purchasedAt DateTime  @default(now())
  usedAt      DateTime?
  expiresAt   DateTime?

  @@map("inventory_items")
}

model Achievement {
  id          String @id @default(cuid())
  key         String @unique
  title       String
  description String
  badgeImage  String?
  xpReward    Int    @default(0)

  icon           String  @default("🏆")
  category       String  @default("general") // quest, habit, level, special
  progressType   String? // quest_count, habit_streak, level, category_quest_count
  progressTarget Int?

  userAchievements UserAchievement[]

  @@map("achievements")
}

model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String
  auth     String

  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}

model NotificationPreferences {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  habitReminders      Boolean @default(true)
  questDeadlineAlerts Boolean @default(true)
  dailySummary        Boolean @default(true)
  dailySummaryTime    String  @default("21:00")
  achievementAlerts   Boolean @default(true)
  levelUpAlerts       Boolean @default(true)

  quietHoursStart String? // "22:00"
  quietHoursEnd   String? // "07:00"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_preferences")
}

model NotificationCategoryPreference {
  id       String               @id @default(cuid())
  userId   String
  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category NotificationCategory
  inAppEnabled Boolean          @default(true)
  pushEnabled  Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, category])
  @@map("notification_category_preferences")
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])

  unlockedAt DateTime @default(now())

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model Relationship {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  type      String
  isPartner Boolean @default(false)
  /// Pareja que también usa Noutlife: el jardín se comparte cuando acepta (PENDING → LINKED).
  partnerUserId String?
  linkStatus    String?

  importantDates Json   @default("[]")
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerUserId])
  @@map("relationships")
}

model XpEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  xpAmount    Int
  goldAmount  Int
  source      String
  sourceId    String?
  description String
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@map("xp_events")
}

// ─── Social / Multiplayer ─────────────────────────────────────────────────────

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("SentRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User     @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  status      String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  /// Racha entre los dos: cuenta un día cuando ambos se escriben (texto o foto).
  /// Se enciende (se muestra) al tercer día seguido.
  streakCount Int      @default(0)
  streakBest  Int      @default(0)
  /// Último día (YYYY-MM-DD, zona de quien envió la solicitud) en que ambos se escribieron.
  streakDay   String?
  /// Fondo de su carta (foto con estética de papel), compartido por los dos.
  background  ChatBackground?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([requesterId, receiverId])
  @@map("friendships")
}

model Challenge {
  id          String   @id @default(cuid())
  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        String   // quests_completed | habits_streak | gym_sessions | savings_percent
  targetValue Int
  goldWager   Int      @default(0)
  startDate   DateTime
  endDate     DateTime
  isPublic    Boolean  @default(false)
  status      String   @default("ACTIVE") // ACTIVE | FINISHED | CANCELLED

  participants ChallengeParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("challenges")
}

model ChallengeParticipant {
  id           String    @id @default(cuid())
  challengeId  String
  challenge    Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentValue Int       @default(0)
  isWinner     Boolean   @default(false)
  joinedAt     DateTime  @default(now())

  @@unique([challengeId, userId])
  @@map("challenge_participants")
}

model Guild {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  emblem      String   @default("shield")
  /// Foto del gremio (data URL JPEG/PNG/WebP recortada en el cliente).
  photoUrl    String?
  leaderId    String
  level       Int      @default(1)
  xp          Int      @default(0)
  inviteCode  String   @unique
  /// Racha del gremio: cuenta un día cuando todos los miembros escriben en su carta.
  /// Se enciende (se muestra) al tercer día seguido.
  streakCount Int      @default(0)
  streakBest  Int      @default(0)
  streakDay   String?

  members  GuildMember[]
  messages GuildMessage[]
  invites  GuildInvite[]
  /// Fondo de la carta del gremio, compartido por todos los miembros.
  background ChatBackground?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("guilds")
}

model GuildMember {
  id       String   @id @default(cuid())
  guildId  String
  guild    Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("MEMBER") // LEADER | OFFICER | MEMBER
  joinedAt DateTime @default(now())
  /// Hasta dónde leyó la carta del gremio (cartas sin leer en la sección Social).
  lastReadAt DateTime?

  @@unique([guildId, userId])
  @@index([userId])
  @@map("guild_members")
}

model GuildMessage {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  /// TEXT | SNAP (foto de la cámara: daña al enemigo del día) | PHOTO (de la galería) | VOICE | STICKER | GAME
  /// | EVENT (aviso de la carta: "bg", "bg-off" o "edit:<campo>").
  kind      String   @default("TEXT")
  photoUrl  String?
  audioUrl  String?
  meta      Json?
  /// Día del gremio (zona de quien lo lidera) de los mensajes que cuentan para la racha y el enemigo.
  dayKey    String?
  createdAt DateTime @default(now())
  replyToId String?
  changedAt DateTime? @map("reactedAt")
  editedAt  DateTime?
  deletedAt DateTime?
  reactions MessageReaction[]

  @@index([guildId, dayKey])
  @@index([guildId, createdAt])
  @@index([guildId, changedAt])
  @@map("guild_messages")
}

model GuildInvite {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  inviterId String
  inviter   User     @relation("GuildInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId String
  invitee   User     @relation("GuildInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  status    String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  createdAt DateTime @default(now())

  @@unique([guildId, inviteeId])
  @@index([inviteeId, status])
  @@map("guild_invites")
}

model DirectMessage {
  id         String    @id @default(cuid())
  senderId   String
  sender     User      @relation("DMSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User      @relation("DMReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  /// TEXT | SNAP (foto de la cámara) | PHOTO (foto de la galería) | VOICE (nota de voz) | STICKER | GAME (minijuego)
  /// | EVENT (aviso de la carta: content "bg" o "bg-off").
  kind       String    @default("TEXT")
  content    String?
  photoUrl   String?
  /// Nota de voz (data URL de audio). Se pide aparte, como la foto.
  audioUrl   String?
  /// Datos ligeros que viajan con el mensaje: miniatura de la foto, forma de onda y
  /// duración de la nota de voz, sticker, estado del minijuego…
  meta       Json?
  habitTitle String?
  /// Día (YYYY-MM-DD, zona de quien envió la solicitud de amistad) de los mensajes que cuentan para la racha.
  dayKey     String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  /// Mensaje al que responde (otro de la misma carta).
  replyToId  String?
  /// Última vez que cambió (reacción, edición, borrado o jugada): el chat en vivo lo usa para avisar.
  changedAt  DateTime? @map("reactedAt")
  editedAt   DateTime?
  /// Borrado para todos: queda el hueco «Mensaje borrado» (las respuestas siguen teniendo a qué apuntar).
  deletedAt  DateTime?
  reactions  MessageReaction[]

  @@index([senderId, receiverId, changedAt])
  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, readAt])
  @@map("direct_messages")
}

/// Fondo de una carta (chat): una foto con estética de papel que ven todos los de la
/// conversación. Pertenece a una amistad (carta entre dos) o a un gremio.
model ChatBackground {
  id           String      @id @default(cuid())
  friendshipId String?     @unique
  friendship   Friendship? @relation(fields: [friendshipId], references: [id], onDelete: Cascade)
  guildId      String?     @unique
  guild        Guild?      @relation(fields: [guildId], references: [id], onDelete: Cascade)
  /// Data URL JPEG/PNG/WebP (el cliente la reduce a ~1080 px).
  photoUrl     String
  /// Encuadre: { x, y } foco 0–1, { zoom } 1–3, { paper } intensidad del papel 0,2–0,9.
  fit          Json        @default("{}")
  setById      String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("chat_backgrounds")
}

/// Gesto entre amigos (saludo, corazón, baile…). Quien lo recibe lo ve en el
/// muñequito pixel de quien lo envió mientras pasea por su zona.
model SocialGesture {
  id        String    @id @default(cuid())
  fromId    String
  from      User      @relation("GestureFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        User      @relation("GestureTo", fields: [toId], references: [id], onDelete: Cascade)
  kind      String
  zone      String?
  seenAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([toId, seenAt, createdAt])
  @@index([fromId, toId, createdAt])
  @@map("social_gestures")
}

