/// Reacción de una persona a un mensaje (una por persona y mensaje; tocarla otra vez la quita).
model MessageReaction {
  id             String         @id @default(cuid())
  dmId           String?
  dm             DirectMessage? @relation(fields: [dmId], references: [id], onDelete: Cascade)
  guildMessageId String?
  guildMessage   GuildMessage?  @relation(fields: [guildMessageId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji          String
  createdAt      DateTime       @default(now())

  @@unique([dmId, userId])
  @@unique([guildMessageId, userId])
  @@map("message_reactions")
}

/// Qué carta tiene abierta cada persona ("dm:<id>" | "guild:<id>") o si la app está en primer plano ("app").
/// Mientras está abierta no se le avisa de lo que llega a esa misma carta.
model ChatView {
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key      String
  at       DateTime
  /// Escribiendo en esa carta (se apaga solo a los pocos segundos).
  typingAt DateTime?

  @@id([userId, key])
  @@map("chat_views")
}

/// Timbre del chat en vivo: cada vez que algo le importa a una persona (un mensaje,
/// una reacción, que alguien escriba, que un amigo cambie de zona…) su `seq` sube.
/// La petición larga del cliente solo mira este número cada segundo.
model LiveSignal {
  userId String   @id
  seq    BigInt   @default(0)
  at     DateTime @default(now())

  @@map("live_signals")
}

/// Ajustes de una carta para una persona: archivada o vaciada ("Eliminar chat" borra
/// el historial solo para ella: no ve lo anterior a clearedAt).
model ChatPref {
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "dm:<amigo>" | "guild:<gremio>"
  key        String
  archivedAt DateTime?
  clearedAt  DateTime?
  updatedAt  DateTime  @updatedAt

  @@id([userId, key])
  @@map("chat_prefs")
}

/// Bloqueo: quien bloquea deja de ser amigo, no recibe cartas, solicitudes ni gestos
/// de esa persona y no la ve en las zonas ni en el directorio (ni ella a quien la bloqueó).
model UserBlock {
  blockerId String
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

/// Imagen de un sticker, guardada una sola vez por su huella (sha256): los mensajes y
/// las colecciones apuntan a ella.
model StickerImage {
  hash      String   @id
  imageUrl  String
  createdAt DateTime @default(now())

  stickers Sticker[]

  @@map("sticker_images")
}

/// Un sticker en la colección de alguien (creado por esa persona o guardado de una carta).
model Sticker {
  id        String       @id @default(cuid())
  ownerId   String
  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  hash      String
  image     StickerImage @relation(fields: [hash], references: [hash])
  /// Quién lo hizo (si se guardó de otra persona).
  authorId  String?
  createdAt DateTime     @default(now())

  @@unique([ownerId, hash])
  @@map("stickers")
}
