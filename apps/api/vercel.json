{
  "version": 2,
  "buildCommand": "npx prisma generate && npx tsx src/migrate-db.ts && npm run build --workspace=@noutlife/api",
  "builds": [
    {
      "src": "src/server.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/server.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/tick",
      "schedule": "0 10 * * *"
    }
  ]
}
